# Development only. Never commit a real .env file.
LXCUP_POSTGRES_DB=lxcup_dev
LXCUP_POSTGRES_USER=lxcup
LXCUP_POSTGRES_PASSWORD=change-me
LXCUP_TEST_POSTGRES_DB=lxcup_test
LXCUP_TEST_POSTGRES_USER=lxcup_test
LXCUP_TEST_POSTGRES_PASSWORD=change-me-test
DATABASE_URL=postgres://lxcup:change-me@127.0.0.1:5433/lxcup_dev
DATABASE_TEST_URL=postgres://lxcup_test:change-me-test@127.0.0.1:5434/lxcup_test

# Production accounts are stored in PostgreSQL. First login: admin / admin;
# change that temporary password immediately.
LXCUP_BIND_ADDRESS=127.0.0.1:8080

# Der Worker nutzt nur diese interne, feste Basis-URL. Keine URL kommt aus dem Frontend.
LXCUP_ARTIFACT_BASE_URL=http://artifacts

# Vom verwalteten Zielsystem erreichbare URL des Controllers (für Agent-Heartbeats).
# Für entfernte Agenten HTTPS verwenden; HTTP ist nur auf Loopback zulässig.
LXCUP_CONTROLLER_URL=https://lxcup.example.com

# Vom Zielhost erreichbare Frontend-URL für Bootstrap- und Windows-Agent-Befehle.
# Für Windows-Agent-Installationen HTTPS verwenden; HTTP ist nur auf Loopback zulässig.
LXCUP_PUBLIC_URL=https://lxcup.example.com

# Nur auf dem lokalen Host erreichbar; Vite leitet /agent an diesen Port weiter.
LXCUP_ARTIFACTS_PORT=8081

# 64 hex characters; as a Docker secret in production, never commit this value.
LXCUP_SECRET_MASTER_KEY=replace-with-64-random-hex-characters
LXCUP_BACKUP_RETENTION_DAYS=30
