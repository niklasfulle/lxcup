# Terminate HTTPS in front of the lxcup server.
# Replace the hostname with the internal DNS name used in production.
lxcup.example.internal {
	@agent_artifacts path /agent/*
	reverse_proxy @agent_artifacts lxcup-artifacts:80
	@metrics path /metrics
	respond @metrics 404
	@health path /health/*
	reverse_proxy @health lxcup-server:8080
	reverse_proxy lxcup-frontend:80
}
